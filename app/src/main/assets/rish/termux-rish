#!/system/bin/sh
# Termux bundled rish launcher. Installed and updated by the APK.
DIRECTORY='@PREFIX@/libexec/termux-rish'
BACKEND=stock
if [ -r "$DIRECTORY/backend" ]; then
    IFS= read -r BACKEND < "$DIRECTORY/backend"
fi
case "${RISH_BACKEND:-$BACKEND}" in
    stock) DEX="$DIRECTORY/rish_shizuku.dex" ;;
    plus) DEX="$DIRECTORY/rish_shizuku_plus.dex" ;;
    *) echo 'rish: RISH_BACKEND must be stock or plus.' >&2; exit 2 ;;
esac
if [ ! -r "$DEX" ] || [ -w "$DEX" ]; then
    echo 'rish: reopen Termux to restore its bundled, read-only shell loader.' >&2
    exit 1
fi
export RISH_APPLICATION_ID='@PACKAGE@'
# Termux private PATH and preload libraries are inaccessible to the ADB shell UID.
export RISH_PRESERVE_ENV="${RISH_PRESERVE_ENV:-0}"
unset LD_PRELOAD LD_LIBRARY_PATH
exec /system/bin/app_process -Djava.class.path="$DEX" /system/bin --nice-name=rish \
    rikka.shizuku.shell.ShizukuShellLoader "$@"
